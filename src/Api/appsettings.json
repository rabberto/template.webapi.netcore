{
  "logging": {
    "logLevel": {
      "default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "console": {
      "enabled": true,
      "minimumLevel": "Information",
      "directoryPath": "./logs"
    },
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information"
      },
      "WriteTo": [
        {
          "Name": "Console"
        },
        {
          "Name": "Elasticsearch",
          "Args": {
            "nodeUris": "http://localhost:9200",
            "autoRegisterTemplate": true,
            "indexFormat": "logstash-{0:yyyy.MM.dd}"
          }
        }
      ]
    }
  },
  "customers": [
    {
      "id": "customer1",
      "name": "Customer 1",
      "subscriptionKey": "hash-subscriptionKey",
      "connectionString": "hash-connectionString"
    }
  ],
  "AllowedHosts": "*"
}